# backend/.env.example — Ortam degiskenleri sablonu (Emirhan: backend yapilandirmasi)
# Bu dosyayi .env olarak kopyalayip Docker/local calistirmada kullanilir.
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dershane
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10
# Virgülle ayrılmış frontend origin listesi (opsiyonel)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dershane
